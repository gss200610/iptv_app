+package expo.modules.video
+
+import okhttp3.HttpUrl
+import okhttp3.Interceptor
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.Response
+import okhttp3.ResponseBody.Companion.asResponseBody
+import okio.Buffer
+import okio.BufferedSource
+import okio.Source
+import okio.Timeout
+import okio.buffer
+import java.io.IOException
+import java.net.ProtocolException
+
+/**
+ * Alguns servidores IPTV encerram a conexão antes de enviar todo o Content-Length (ex.: a cada 512 KB).
+ * Players como VLC reconectam com Range a partir do último byte recebido; o ExoPlayer trata isso como erro.
+ * Este interceptor faz a reconexão de forma transparente para o OkHttpDataSource.
+ */
+class ResumingInterceptor(private val client: OkHttpClient) : Interceptor {
+  override fun intercept(chain: Interceptor.Chain): Response {
+    val request = chain.request()
+    val response = chain.proceed(request)
+    if (request.method != "GET" || (response.code != 200 && response.code != 206)) return response
+    val body = response.body ?: return response
+    val length = body.contentLength()
+    if (length <= 0) return response
+
+    val start = if (response.code == 206) parseContentRangeStart(response.header("Content-Range")) else 0L
+    if (start == null) return response
+
+    val source = ResumingSource(
+      client = client,
+      request = request,
+      resumeUrl = response.request.url,
+      initial = body.source(),
+      start = start,
+      length = length
+    )
+    return response.newBuilder().body(source.buffer().asResponseBody(body.contentType(), length)).build()
+  }
+
+  private fun parseContentRangeStart(header: String?): Long? {
+    val match = Regex("""bytes\s+(\d+)-\d+/""").find(header ?: return null) ?: return null
+    return match.groupValues[1].toLongOrNull()
+  }
+}
+
+private class ResumingSource(
+  private val client: OkHttpClient,
+  private val request: Request,
+  private val resumeUrl: HttpUrl,
+  initial: BufferedSource,
+  private val start: Long,
+  private val length: Long
+) : Source {
+  private var current: BufferedSource = initial
+  private var received = 0L
+  private var failures = 0
+
+  @Volatile
+  private var closed = false
+
+  override fun read(sink: Buffer, byteCount: Long): Long {
+    if (received >= length) return -1
+    while (true) {
+      val count = try {
+        current.read(sink, minOf(byteCount, length - received))
+      } catch (e: IOException) {
+        if (closed || failures >= MAX_CONSECUTIVE_FAILURES) throw e
+        CUT
+      }
+      if (count > 0) {
+        received += count
+        failures = 0
+        return count
+      }
+      if (received >= length) return -1
+      if (closed || failures >= MAX_CONSECUTIVE_FAILURES) throw ProtocolException("unexpected end of stream")
+      reopen()
+    }
+  }
+
+  private fun reopen() {
+    failures += 1
+    runCatching { current.close() }
+    val from = start + received
+    val end = start + length - 1
+    // Primeiro a URL final (após redirecionamentos, com token); se expirar, a URL original refaz a cadeia.
+    val urls = if (resumeUrl == request.url) listOf(resumeUrl) else listOf(resumeUrl, request.url)
+    var lastError: IOException? = null
+    for (url in urls) {
+      val next = request.newBuilder().url(url).header("Range", "bytes=$from-$end").build()
+      val response = try {
+        client.newCall(next).execute()
+      } catch (e: IOException) {
+        lastError = e
+        continue
+      }
+      val body = response.body
+      val contentRange = response.header("Content-Range") ?: ""
+      if (response.code == 206 && body != null && contentRange.startsWith("bytes $from-")) {
+        current = body.source()
+        return
+      }
+      response.close()
+      lastError = IOException("Resume failed: HTTP ${response.code} $contentRange")
+    }
+    throw lastError ?: IOException("Resume failed")
+  }
+
+  override fun timeout(): Timeout = current.timeout()
+
+  override fun close() {
+    closed = true
+    current.close()
+  }
+
+  private companion object {
+    const val MAX_CONSECUTIVE_FAILURES = 5
+    const val CUT = 0L
+  }
+}
